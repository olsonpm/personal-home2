<!DOCTYPE html>
<html lang="en-US">
  <head>
    <title>Phil Olson</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:image" content="/images/for-linkedin.png"/>
    <meta name="description" content="Phil Olson's informal supplement to his resume that emphasizes personal projects." />

    <link rel="icon" type="image/png" href="/images/favicon.16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="/images/favicon.32.png" sizes="32x32">

    {% if page === 'ux-clips' -%}
    <meta name="robots" content="noindex">
    {%- endif -%}

    {%- for fontAsset in nunjucksWebpackPlugin.fonts -%}
    <link rel="preload" href="{{ fontAsset }}" as="font" type="font/woff2">
    {%- endfor -%}

    {% if isDevelopment -%}
    {%- for cssAsset in nunjucksWebpackPlugin.css -%}
    <link rel="stylesheet" type="text/css" href="{{ cssAsset }}">
    {%- endfor -%}
    {% else %}
    <style>
{{ nunjucksWebpackPlugin.cssInline }}
    </style>
    {% endif %}

  </head>

  <body>
    {%- import '../macros/global.njk' as gm %}
    <div class="site-container">
      {%- filter indent(4, true) %}
      {% block content %}{% endblock %}
      {%- endfilter %}
    </div>

    {% include 'partials/footer.njk' %}

    {% for jsAsset in nunjucksWebpackPlugin.js %}
    <script src="{{ jsAsset }}"></script>
    {%- endfor %}
  </body>

</html>
