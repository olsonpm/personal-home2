{
  "name": "personal-home2",
  "version": "0.2.4",
  "description": "just my personal home website yo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olsonpm/personal-home2.git"
  },
  "scripts": {
    "build-app": "rm -rf app && mkdir app && cp -r license.txt pnpm*.yaml package.json server.js static app",
    "build-dev": "NODE_ENV='development' webpack",
    "build-prod": "NODE_ENV='production' webpack",
    "build-prod-app": "npm run build-prod && npm run build-app",
    "build-dev-app": "npm run build-dev && npm run build-app",
    "preview": "HOME_PREVIEW=true node app/server.js",
    "dev": "sh ./scripts/dev.sh",
    "docker-build": "npm run build-prod-app && sh ./scripts/docker-build.sh",
    "docker-push": "sh ./scripts/docker-push.sh",
    "docker-build-and-push": "npm run docker-build && npm run docker-push",
    "build-and-trust-local-dev-certs": "sh ./scripts/build-local-dev-certs.sh && sh ./scripts/trust-local-dev-certs.sh"
  },
  "author": "phil olson",
  "homepage": "https://github.com/olsonpm/personal-home2#readme",
  "devDependencies": {
    "@babel/core": "^7.0.0-beta.51",
    "@babel/preset-env": "^7.0.0-beta.51",
    "autoprefixer": "^8.6.4",
    "babel-loader": "^8.0.0-beta.4",
    "clean-webpack-plugin": "^0.1.19",
    "css-loader": "^0.28.11",
    "domtastic": "^0.15.8",
    "eslint": "^5.0.1",
    "eslint-config-personal": "github:olsonpm/eslint-config-personal",
    "file-loader": "^1.1.11",
    "mini-css-extract-plugin": "^0.4.0",
    "nodemon": "^3.1.10",
    "normalize-scss": "^8.0.0",
    "nunjucks": "^3.1.3",
    "nunjucks-webpack-plugin": "github:olsonpm/nunjucks-webpack-plugin#09cc757c4791bb518bcb0015abafc1736aff431e",
    "postcss-clean": "^1.1.0",
    "postcss-loader": "^2.1.5",
    "prettier": "^1.13.6",
    "sass": "^1.72.0",
    "sass-loader": "^7.0.3",
    "style-loader": "^0.21.0",
    "terser-webpack-plugin": "^4.2.3",
    "url-loader": "^1.0.1",
    "velocity-animate": "github:olsonpm/velocity#ee507394e2d5efe10d68cfd190aa1ccd5aff43a8",
    "webpack": "^4.12.2",
    "webpack-cli": "^3.0.8",
    "webpack-dev-server": "^3.1.4"
  },
  "dependencies": {
    "koa": "^2.5.1",
    "koa-compress": "^3.0.0",
    "koa-static": "^5.0.0"
  },
  "eslintConfig": {
    "extends": "personal"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": false
  },
  "license": "SEE LICENSE IN license.txt",
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
